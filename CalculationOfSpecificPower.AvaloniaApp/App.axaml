<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalculationOfSpecificPower.AvaloniaApp.App"
             xmlns:local="using:CalculationOfSpecificPower.AvaloniaApp"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CalculationOfSpecificPower.AvaloniaApp/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CalculationOfSpecificPower.AvaloniaApp/Styles/GlassTheme.axaml" />
  </Application.Styles>
</Application>
