<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="BgDeep">#07090D</Color>
  <Color x:Key="GlassFill">#28FFFFFF</Color>
  <Color x:Key="GlassFillHover">#36FFFFFF</Color>
  <Color x:Key="GlassBorder">#55FFFFFF</Color>
  <Color x:Key="GlassHighlight">#33FFFFFF</Color>
  <Color x:Key="TextPrimary">#F2F5FA</Color>
  <Color x:Key="TextSecondary">#A8B3C7</Color>
  <Color x:Key="TextMuted">#6E7A90</Color>
  <Color x:Key="Accent">#6EC8FF</Color>
  <Color x:Key="AccentSoft">#3A6EC8FF</Color>
  <Color x:Key="AccentDeep">#2A6FA8</Color>
  <Color x:Key="Success">#6ED6B0</Color>
  <Color x:Key="Warning">#E0B46A</Color>
  <Color x:Key="Danger">#E08A8A</Color>

  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource TextMuted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="Brush.GlassBorder" Color="{StaticResource GlassBorder}" />

</ResourceDictionary>
